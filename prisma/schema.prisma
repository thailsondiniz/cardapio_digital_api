// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusPedido {
  RECEBIDO
  EM_PREPARO
  CONCLUIDO
}

enum StatusAtendimento {
  ABERTO
  AGUARDANDO_PAGAMENTO
  FECHADO
}

enum StatusMesa{
  DISPONIVEL
  OCUPADA
  INATIVA
}

enum Role {
  PROPRIETARIO
  ADMIN
  FUNCIONARIO
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantes RestauranteMembro[]
}

model Restaurante {
  id Int @id @default(autoincrement())
  nome String
  slug String @unique
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros      RestauranteMembro[]
  categorias   Categoria[]
  produtos     Produto[]
  mesas        Mesa[]
  clientes     Cliente[]
  atendimentos Atendimento[]
}

model RestauranteMembro {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  restauranteId  Int
  role           Role     @default(FUNCIONARIO)

  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])

  @@unique([usuarioId, restauranteId])
}


model Categoria {
  id            Int      @id @default(autoincrement())
  nome          String
  restauranteId Int

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])

  produtos Produto[]

  @@unique([id, restauranteId])
  @@unique([restauranteId, nome])
}
model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String      
  restauranteId Int
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  @@unique([id, restauranteId])
  @@unique([restauranteId, telefone])
}

model Produto {
  id          Int          @id @default(autoincrement())
  nome        String
  descricao   String?
  preco       Decimal @db.Decimal(10, 2)
  disponivel  Boolean  @default(true)

  restauranteId Int
  categoriaId   Int
  
  restaurante Restaurante @relation(fields: [restauranteId],references: [id])
  categoria Categoria @relation(fields: [categoriaId, restauranteId],references: [id, restauranteId])
  itensPedido ItemPedido[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@unique([id, restauranteId])
}

model Pedido {
  id            Int          @id @default(autoincrement())
  atendimentoId Int
  restauranteId Int
  status        StatusPedido @default(RECEBIDO)
  createdAt     DateTime     @default(now())
  
  atendimento Atendimento  @relation(fields: [atendimentoId, restauranteId], references: [id, restauranteId])
  itensPedido ItemPedido[]
  @@unique([id, restauranteId])
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int
  restauranteId Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  preco_total   Decimal @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId, restauranteId],references: [id, restauranteId])

  produto Produto @relation(fields: [produtoId, restauranteId], references: [id, restauranteId]  )

  @@unique([pedidoId, produtoId])
}

model Mesa {
  id           Int           @id @default(autoincrement())
  numero       Int          
  capacidade Int @default(4)
  status StatusMesa @default(DISPONIVEL)
  ativa Boolean @default(true)
  qrCodeToken String @unique @default(uuid())
  restauranteId Int

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  atendimentos Atendimento[]
  @@unique([id, restauranteId])
  @@unique([restauranteId, numero])
}

model Atendimento {
  id        Int               @id @default(autoincrement())
  clienteId Int
  mesaId    Int
  restauranteId Int
  status    StatusAtendimento @default(ABERTO)
  abertoEm  DateTime          @default(now())
  fechadoEm DateTime?

  cliente Cliente  @relation(fields: [clienteId, restauranteId], references: [id, restauranteId])
  mesa    Mesa     @relation(fields: [mesaId, restauranteId], references: [id, restauranteId])
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  pedidos Pedido[]

  @@unique([id, restauranteId])
}
